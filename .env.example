PORT=4300
# 127.0.0.1 when running behind IIS/nginx; 0.0.0.0 to reach it from phones on the LAN
HOST=0.0.0.0
# Folder holding the music (OneDrive-synced folder on a PC, rclone mount on a server)
LIBRARY_DIR=C:\Users\you\OneDrive\Narendras musicbox
# DB_PATH defaults to data/musicbox.db inside the app folder
# Long random string - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
